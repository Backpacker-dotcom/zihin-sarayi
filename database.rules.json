{
  "rules": {
    "zs": {
      "$t": {
        "login": {
          ".read": true,
          "$k": {
            ".write": "auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher')"
          }
        },
        "pub": {
          ".read": "auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true",
          "meta": {
            ".write": "auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner'"
          },
          "users": {
            "$uid": {
              ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner') || (auth!=null && auth.uid===$uid && !root.child('zs/'+$t+'/pub/users').exists() && newData.child('r').val()==='owner') || ((auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher') && (!data.exists() || data.child('r').val()==='student') && (!newData.exists() || newData.child('r').val()==='student'))",
              ".validate": "newData.hasChildren(['n','u','r'])",
              "em": {
                ".write": "auth!=null && auth.uid===$uid"
              }
            }
          },
          "homework": {
            ".write": "auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher')"
          },
          "exams": {
            ".write": "auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher')"
          },
          "content": {
            ".write": "auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher')"
          },
          "qa": {
            "$q": {
              ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher')) || ((auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true) && ((!data.exists() && newData.child('f').val()===auth.uid) || (data.child('f').val()===auth.uid && !newData.exists() && !data.child('r').exists())))",
              ".validate": "newData.child('x').isString() && newData.child('x').val().length<=3000",
              "la": {
                ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true) && data.parent().child('f').val()===auth.uid"
              },
              "st": {
                ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true) && data.parent().child('f').val()===auth.uid && newData.val()==='open'"
              },
              "r": {
                "$r": {
                  ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true) && !data.exists() && newData.child('f').val()===auth.uid && root.child('zs/'+$t+'/pub/qa/'+$q+'/f').val()===auth.uid",
                  ".validate": "newData.child('x').isString() && newData.child('x').val().length<=4000"
                }
              }
            }
          },
          "boards": {
            ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher'))"
          },
          "goal": {
            ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher'))"
          },
          "lb": {
            "$uid": {
              ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && auth.uid===$uid) || (auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher'))",
              ".validate": "newData.child('xp').isNumber() && newData.child('xp').val()>=0 && newData.child('xp').val()<1000000 && newData.child('wx').isNumber() && newData.child('wx').val()<100000"
            }
          },
          "dc": {
            "$d": {
              "$uid": {
                ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && auth.uid===$uid && !data.exists()) || (auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher'))",
                ".validate": "newData.child('s').isNumber() && newData.child('s').val()>=0 && newData.child('s').val()<=10"
              }
            }
          },
          "cmp": {
            ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher'))"
          },
          "ce": {
            "$c": {
              "$uid": {
                ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && auth.uid===$uid && !data.exists() && root.child('zs/'+$t+'/pub/cmp/'+$c).exists() && root.child('zs/'+$t+'/pub/cmp/'+$c+'/closed').val()!==true) || (auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher'))",
                ".validate": "newData.child('s').isNumber() && newData.child('s').val()>=0 && newData.child('s').val()<=newData.child('n').val() && newData.child('n').val()<=40"
              },
              ".write": "(auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher'))"
            }
          }
        },
        "u": {
          ".read": "auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher')",
          "$uid": {
            ".read": "auth!=null && auth.uid===$uid",
            ".write": "auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher')",
            "results": {
              "$r": {
                ".write": "auth!=null && auth.uid===$uid && !data.exists()"
              }
            },
            "msgs": {
              "$m": {
                ".write": "auth!=null && auth.uid===$uid && !data.exists() && newData.child('f').val()===auth.uid",
                ".validate": "newData.child('x').isString() && newData.child('x').val().length<=4000"
              }
            },
            "reads": {
              "s": {
                ".write": "auth!=null && auth.uid===$uid"
              }
            },
            "hwdone": {
              "$h": {
                ".write": "auth!=null && auth.uid===$uid",
                ".validate": "!newData.child('ans').exists() || (newData.child('ans').isString() && newData.child('ans').val().length<=6000)"
              }
            },
            "karne": {
              "$k": {
                ".write": "auth!=null && auth.uid===$uid && !data.exists() && newData.child('by').val()==='auto'"
              }
            },
            "progress": {
              ".write": "auth!=null && auth.uid===$uid"
            },
            "qread": {
              ".write": "auth!=null && auth.uid===$uid"
            },
            "pq": {
              "$q": {
                ".write": "auth!=null && auth.uid===$uid && ((!data.exists() && newData.child('f').val()===auth.uid) || (!newData.exists() && !data.child('r').exists()))",
                ".validate": "newData.child('x').isString() && newData.child('x').val().length<=3000",
                "la": {
                  ".write": "auth!=null && auth.uid===$uid"
                },
                "st": {
                  ".write": "auth!=null && auth.uid===$uid && newData.val()==='open'"
                },
                "r": {
                  "$r": {
                    ".write": "auth!=null && auth.uid===$uid && !data.exists() && newData.child('f').val()===auth.uid",
                    ".validate": "newData.child('x').isString() && newData.child('x').val().length<=4000"
                  }
                }
              }
            }
          }
        },
        "st": {
          "$uid": {
            ".read": "(auth!=null && auth.uid===$uid) || ((auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher')) && root.child('zs/'+$t+'/pub/users/'+$uid+'/r').val()!=='owner')",
            ".write": "(auth!=null && auth.uid===$uid) || ((auth!=null && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true && (root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' || root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='teacher')) && root.child('zs/'+$t+'/pub/users/'+$uid+'/r').val()!=='owner')"
          }
        },
        "me": {
          "$uid": {
            ".read": "auth!=null && auth.uid===$uid",
            ".write": "auth!=null && auth.uid===$uid && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/r').val()==='owner' && root.child('zs/'+$t+'/pub/users/'+auth.uid+'/a').val()===true"
          }
        }
      }
    }
  }
}